{
  "name": "@edc/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "pnpm --filter @edc/shared build && react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "pnpm --filter @edc/shared build && react-router typegen && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "images": "node scripts/optimise-images.mjs"
  },
  "dependencies": {
    "@edc/shared": "workspace:*",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@radix-ui/react-visually-hidden": "1.2.13",
    "@react-router/node": "7.18.5",
    "@react-router/serve": "7.18.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "isbot": "5.2.2",
    "lucide-react": "1.66.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router": "7.18.5",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@react-router/dev": "7.18.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vercel/react-router": "1.3.7",
    "jsdom": "26.1.0",
    "sharp": "0.34.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
