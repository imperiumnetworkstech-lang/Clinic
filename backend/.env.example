# Copy to backend/.env for local development. Never commit real values.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local: started by `pnpm db:start` (embedded Postgres, data in backend/.data/pg).
# Production: Neon pooled connection string with DATABASE_SSL=true.
DATABASE_URL=postgres://edc:edc_local_pw@localhost:54329/edc
DATABASE_SSL=false
DATABASE_POOL_MAX=5

# Website origin(s) allowed to call the API with credentials.
APP_ORIGIN=http://localhost:5173
CORS_ORIGINS=
# true behind Vercel / any reverse proxy, so rate limits see the real client IP.
TRUST_PROXY=false

# Generate each secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
STAFF_REFRESH_TTL_DAYS=7
PATIENT_REFRESH_TTL_DAYS=30

# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
HMAC_SECRET=

TOTP_ISSUER=Expressions Dental
# Must stay true in production. May be set false locally to skip authenticator setup.
ENFORCE_STAFF_2FA=true

# log = print patient OTP codes to the dev log (forbidden in production); none = disabled.
OTP_DELIVERY=log

# Protects /api/v1/cron/* (Vercel Cron sends it as a Bearer token). Phase 6.
CRON_SECRET=

# Only for `pnpm db:seed -- --demo` (local). 12+ characters.
DEMO_SEED_PASSWORD=
