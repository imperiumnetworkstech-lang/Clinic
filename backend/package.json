{
  "name": "@edc/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:start": "tsx --env-file-if-exists=.env scripts/db-start.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts up",
    "db:rollback": "tsx --env-file-if-exists=.env scripts/migrate.ts down",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts"
  },
  "dependencies": {
    "@edc/shared": "workspace:*",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "otplib": "12.0.1",
    "pg": "8.23.1",
    "pg-hstore": "2.3.4",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "qrcode": "1.5.4",
    "sequelize": "6.37.8",
    "swagger-ui-express": "5.0.1",
    "umzug": "3.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "embedded-postgres": "17.11.0-beta.19",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
